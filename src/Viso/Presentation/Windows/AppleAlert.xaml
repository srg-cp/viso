<Window x:Class="Viso.AppleAlert" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/Viso;component/Resources/Branding/viso.png" Title="Viso" Width="430" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" FontFamily="SF Pro Text, Helvetica Neue, Segoe UI" KeyDown="AlertKeyDown">
  <Border x:Name="AlertSurface" Margin="16" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="28" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect Color="#252536" BlurRadius="22" ShadowDepth="4" Opacity="0.2"/></Border.Effect>
    <StackPanel>
      <Image Source="/Viso;component/Resources/Branding/viso.png" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock x:Name="AlertTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
      <TextBlock x:Name="AlertMessage" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Margin="0,10,0,22" TextWrapping="Wrap" MaxHeight="240"/>
      <Button x:Name="AcceptButton" Content="Aceptar" IsDefault="True" Click="AcceptClick" Background="{DynamicResource AccentBrush}" Foreground="White"/>
    </StackPanel>
  </Border>
</Window>
