<Window x:Class="CapturaTutor.AnswerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="CapturaTutor · Respuesta" Width="440" Height="440" MinWidth="300" MinHeight="220" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="Respuesta" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ModelText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#83E7D3" FontSize="12"/></Grid>
    <TextBlock x:Name="MetaText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,14"/>
    <TextBox x:Name="AnswerText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="#192333" Padding="12" FontSize="16"/>
    <WrapPanel Grid.Row="3" Margin="0,14,0,0"><Button x:Name="CopyButton" Content="Copiar" Click="CopyClick" Padding="12,7"/><Button Content="Guardar .txt" Click="ExportClick" Padding="12,7"/><Button Content="Ocultar" Click="HideClick" Padding="12,7"/></WrapPanel>
  </Grid>
</Window>
